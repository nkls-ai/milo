---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Talk from '../components/demos/Talk.astro';
import Dictation from '../components/demos/Dictation.astro';
import Work from '../components/demos/Work.astro';
import Asks from '../components/demos/Asks.astro';
import Helpers from '../components/demos/Helpers.astro';
import Memory from '../components/demos/Memory.astro';
import Phone from '../components/demos/Phone.astro';
import Meetings from '../components/demos/Meetings.astro';
import Trust from '../components/Trust.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import Footer from '../components/Footer.astro';

const title = 'Milo, your coworker on the Mac';
const description = "Milo is a small coworker who lives in the corner of your Mac. Tell him what you need. He does it where you can see, asks before anything you can't undo, and remembers what matters.";
---
<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <Hero />
    <Talk />
    <Dictation />
    <Work />
    <Asks />
    <Helpers />
    <Memory />
    <Phone />
    <Meetings />
    <Trust />
    <Pricing />
    <Faq />
    <Waitlist />
  </main>
  <Footer />
</Base>
<script>
  import '../scripts/milo';
</script>
