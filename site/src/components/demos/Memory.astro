---
const facts = [
  { topic: 'People', text: 'Anna is your sister. Her birthday is March 3.' },
  { topic: 'People', text: "Tom is Anna's husband." },
  { topic: 'People', text: 'Dr. Weber is your dentist.' },
  { topic: 'Home', text: 'The plumber is Becker. He fixed the kitchen tap in March.' },
  { topic: 'Home', text: 'The bins go out on Tuesday evenings.' },
  { topic: 'Work', text: 'Mondays are bad for calls.' },
  { topic: 'Habits', text: 'You like reminders the evening before.' },
  { topic: 'Habits', text: 'You write to Anna in German.' },
];
const topics = ['Everything', 'People', 'Home', 'Work', 'Habits'];
---
<section class="section" id="memory" aria-labelledby="memory-title">
  <div class="wrap feature flip">
    <div class="section-head">
      <h2 id="memory-title">What he knows is a list you can read.</h2>
      <p>He remembers your people, your plans and how you like things, and brings it up when it changes the answer. It's all kept on your Mac as plain notes.</p>
      <p>Open the list to fix what's wrong, or make him forget something for good.</p>
    </div>

    <div class="mem" data-mem>
      <div class="window">
        <div class="window-bar"><span class="lights"><i></i><i></i><i></i></span><span class="window-title">What Milo knows</span></div>
        <div class="mem-body">
          <div class="mem-topics" role="tablist" aria-label="Topics">
            {topics.map((t, i) => (
              <button type="button" role="tab" class="mem-topic" data-topic={t} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t}</button>
            ))}
          </div>
          <div role="tabpanel" aria-label="What Milo knows">
          <ul class="mem-list" data-list>
            {facts.map((f) => (
              <li class="fact" data-topic={f.topic}>
                <span class="fact-dot" aria-hidden="true"></span>
                <span class="fact-text" data-text>{f.text}</span>
                <span class="fact-acts">
                  <button type="button" class="fact-btn" data-edit>Edit</button>
                  <button type="button" class="fact-btn" data-forget>Forget</button>
                </span>
              </li>
            ))}
          </ul>
          </div>
          <p class="mem-toast" data-toast role="status"><span data-toast-text></span> <button type="button" class="fact-btn" data-undo>Undo</button></p>
        </div>
      </div>
      <figure class="mem-quote">
        <p class="bubble">You said Mondays are bad for calls. This one's on a Monday.</p>
        <figcaption class="note">What he says when a call gets booked for a Monday.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .mem-body { display: grid; grid-template-columns: 9.5rem 1fr; min-height: 21rem; position: relative; }
  .mem-topics { display: grid; align-content: start; gap: 0.15rem; padding: 0.7rem 0.5rem; border-right: 1px solid var(--rule); background: var(--card-2); }
  .mem-topic { text-align: left; border: 0; background: none; padding: 0.4rem 0.65rem; border-radius: 0.45rem; font-size: 0.92rem; font-weight: 600; color: var(--ink-2); }
  .mem-topic:hover { color: var(--ink); background: var(--lavender-wash); }
  .mem-topic[aria-selected='true'] { background: var(--lavender); color: var(--on-lavender); }
  .mem-list { list-style: none; margin: 0; padding: 0.4rem 0.6rem 3.5rem; }
  .fact {
    display: grid; grid-template-columns: auto 1fr auto; gap: 0.7rem; align-items: center;
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.98rem; line-height: 1.4;
    transition: opacity 260ms, transform 260ms;
  }
  .fact[hidden] { display: none; }
  .fact.is-going { opacity: 0; transform: translateX(0.8rem); }
  .fact-dot { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--lavender-soft); }
  .fact-acts { display: flex; gap: 0.25rem; }
  .fact-acts .fact-btn { color: var(--ink-3); }
  .fact:hover .fact-btn, .fact:focus-within .fact-btn { color: var(--lavender-deep); }
  .fact-btn { border: 0; background: none; padding: 0.2rem 0.45rem; border-radius: 0.35rem; font-size: 0.82rem; font-weight: 650; color: var(--lavender-deep); }
  .fact-btn:hover { background: var(--lavender-wash); }
  .mem-list :global(.fact-input) { width: 100%; border: 0; border-radius: 0.35rem; padding: 0.2rem 0.4rem; margin: -0.2rem -0.4rem; background: var(--lavender-wash); box-shadow: inset 0 0 0 1.5px var(--lavender); font-size: inherit; line-height: inherit; }
  .mem-list :global(.fact-input:focus) { outline: none; }
  .mem-toast {
    position: absolute; left: 50%; bottom: 0.9rem;
    transform: translate(-50%, 0.5rem); opacity: 0; pointer-events: none;
    display: flex; align-items: center; gap: 0.6rem;
    background: var(--ink); color: var(--paper);
    padding: 0.4rem 0.5rem 0.4rem 1rem; border-radius: var(--radius-pill);
    font-size: 0.92rem; font-weight: 600; white-space: nowrap;
    transition: opacity 200ms, transform 300ms var(--ease-spring);
  }
  .mem-toast.is-on { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  .mem-toast .fact-btn { color: var(--lavender-soft); }
  .mem-toast .fact-btn:hover { background: rgb(255 255 255 / 0.12); }
  .mem-quote { margin: 1.3rem 0 0 auto; display: grid; justify-items: end; gap: 0.6rem; max-width: 22rem; }
  @media (max-width: 34rem) {
    .mem-body { grid-template-columns: 1fr; }
    .mem-topics { display: flex; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--rule); padding: 0.5rem; }
    .mem-topic { white-space: nowrap; }
  }
</style>

<script>
  import { $, $$ } from '../../scripts/demo';
  const root = $(document, '[data-mem]');
  const tabs = $$<HTMLButtonElement>(root, '[role="tab"]');
  const facts = $$(root, '.fact');
  const toast = $(root, '[data-toast]');
  const toastText = $(root, '[data-toast-text]');
  const undo = $<HTMLButtonElement>(root, '[data-undo]');
  let topic = 'Everything';
  let lastForgot: HTMLElement | null = null;
  let toastTimer = 0;

  const filter = () => {
    for (const f of facts) f.hidden = f.dataset.gone === '1' || (topic !== 'Everything' && f.dataset.topic !== topic);
  };
  const select = (t: HTMLButtonElement, focus = false) => {
    for (const x of tabs) { x.setAttribute('aria-selected', String(x === t)); x.tabIndex = x === t ? 0 : -1; }
    topic = t.dataset.topic!;
    filter();
    if (focus) t.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { e.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length], true); }
    });
  });

  const say = (text: string, canUndo: boolean) => {
    clearTimeout(toastTimer);
    toastText.textContent = text;
    undo.hidden = !canUndo;
    toast.classList.add('is-on');
    toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), 5000);
  };

  for (const f of facts) {
    const text = $(f, '[data-text]');
    $(f, '[data-forget]').addEventListener('click', () => {
      f.classList.add('is-going');
      setTimeout(() => {
        f.dataset.gone = '1';
        filter();
        f.classList.remove('is-going');
      }, 260);
      lastForgot = f;
      say('Forgotten.', true);
      // keep keyboard focus somewhere sensible
      const next = facts.find((x) => x !== f && !x.hidden && x.dataset.gone !== '1');
      if (next) $(next, '[data-forget]').focus();
    });
    $(f, '[data-edit]').addEventListener('click', () => {
      if (f.querySelector('input')) return;
      const input = document.createElement('input');
      input.className = 'fact-input';
      input.value = text.textContent!;
      input.setAttribute('aria-label', 'Change what Milo knows');
      const old = text.textContent!;
      text.replaceChildren(input);
      input.focus();
      input.select();
      let finished = false;
      const finish = (keep: boolean, refocus = false) => {
        if (finished) return;
        finished = true;
        const v = input.value.trim();
        text.textContent = keep && v ? v : old;
        if (keep && v && v !== old) say("Got it. I'll remember it that way.", false);
        if (refocus) $(f, '[data-edit]').focus();
      };
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') finish(true, true);
        if (e.key === 'Escape') { e.stopPropagation(); finish(false, true); }
      });
      input.addEventListener('blur', () => finish(true));
    });
  }
  undo.addEventListener('click', () => {
    if (!lastForgot) return;
    delete lastForgot.dataset.gone;
    filter();
    say('Back on the list.', false);
    $(lastForgot, '[data-forget]').focus();
    lastForgot = null;
  });
</script>
