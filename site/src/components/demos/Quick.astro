---
import Character from '../Character.astro';
import '../../styles/done-card.css';

const things = [
  'Haircut on Friday at one.',
  'Put oat milk on my shopping list.',
  'Set a timer for ten minutes.',
  "Draft a mail to Anna that I'm running late.",
  'Make a note: the boiler service is on the 14th.',
];
---
<section class="section" id="quick" aria-labelledby="quick-title">
  <div class="wrap">
    <div class="quick-head">
      <div class="section-head">
        <h2 id="quick-title">Small things take two seconds.</h2>
        <p>A calendar entry, a to-do, a timer, a note, a mail draft, the music, one of your shortcuts. He doesn't go off to work on these. They're done in about two seconds, and he tells you once they really are.</p>
      </div>
      <div class="section-head quick-side">
        <p>A small card springs out of him with a check. Click it and the thing opens where it lives. Changed your mind? Press Undo on the card, or just say "undo that", even an hour later.</p>
        <p class="note">A to-do goes into the reminders you already use, so it's on your phone too. A shortcut asks before it runs, because nothing can undo it.</p>
      </div>
    </div>

    <div class="quick" data-quick data-has-milo>
      <div class="quick-say">
        <p class="quick-label" id="quick-say">Say to Milo:</p>
        <ul class="quick-list" aria-labelledby="quick-say">
          {things.map((t, i) => (
            <li><button type="button" class="quick-thing" data-thing={i}><span class="quick-q" aria-hidden="true">“</span>{t}</button></li>
          ))}
          <li><button type="button" class="quick-thing quick-undo" data-undo-that disabled><span class="quick-q" aria-hidden="true">“</span>Undo that.</button></li>
        </ul>
      </div>

      <div class="quick-stage">
        <p class="words quick-words" data-words aria-hidden="true"><span class="wave"><i></i><i></i><i></i><i></i><i></i></span><span data-text></span></p>
        <div class="quick-deck" data-deck aria-label="What Milo just did" role="list"></div>
        <div class="quick-milo">
          <p class="bubble quick-bubble" data-reply aria-live="polite"></p>
          <Character id="quick" pose="idle" label="Milo, with small cards for what he just did" />
        </div>
        <p class="quick-info" data-info aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<style>
  .quick-head { display: grid; gap: 0 clamp(2rem, 4vw, 4.5rem); }
  @media (min-width: 60rem) {
    .quick-head { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: end; }
    .quick-side { padding-bottom: 0.2rem; }
  }
  .quick {
    display: grid; gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    background: var(--paper-2);
    border-radius: 1.6rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  @media (min-width: 52rem) { .quick { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: stretch; } }

  .quick-label { font-weight: 650; color: var(--ink-2); font-size: var(--step--1); }
  .quick-list { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; gap: 0.15rem; }
  .quick-thing {
    display: flex; gap: 0.35rem; align-items: baseline;
    width: 100%; text-align: left;
    border: 0; border-radius: 0.8rem;
    padding: 0.6rem 0.8rem 0.6rem 0.6rem;
    background: transparent; color: var(--ink);
    font-size: 1.05rem; font-weight: 600; line-height: 1.3;
    transition: background-color 150ms;
  }
  .quick-thing:hover:not(:disabled) { background: var(--card); }
  .quick-thing[aria-pressed='true'] { background: var(--card); box-shadow: inset 0 0 0 1.5px var(--lavender-soft); }
  .quick-q { font-family: var(--font-display); font-size: 1.5em; line-height: 0; color: var(--lavender); transform: translateY(0.18em); }
  .quick-undo { margin-top: 0.35rem; color: var(--lavender-deep); }
  .quick-undo:disabled { color: var(--ink-3); cursor: default; }
  .quick-undo:disabled .quick-q { color: var(--ink-3); }

  .quick-stage { position: relative; min-height: 19.5rem; border-radius: 1.1rem; background: var(--paper); box-shadow: inset 0 0 0 1px var(--rule); overflow: hidden; }
  .quick-words { position: absolute; left: 1rem; top: 1rem; max-width: calc(100% - 2rem); opacity: 0; transform: translateY(0.3rem); transition: opacity 200ms, transform 260ms var(--ease-out); }
  .quick-words.is-on { opacity: 1; transform: none; }

  .quick-milo { position: absolute; right: 0.4rem; bottom: 0.6rem; width: clamp(6.5rem, 12vw, 8.5rem); }
  .quick-bubble {
    position: absolute; right: 30%; bottom: 92%;
    width: max-content; max-width: min(17rem, 60vw);
    opacity: 0; transform: translateY(0.3rem) scale(0.94); transform-origin: 90% 100%;
    transition: opacity 180ms, transform 320ms var(--ease-spring);
    z-index: 5;
  }
  .quick-bubble.is-on { opacity: 1; transform: none; }

  /* The deck: up to three cards, newest in front, the others peeking out above; under the pointer
     they fan out upwards so each can be clicked. */
  .quick-deck { --u: 0.078rem; position: absolute; right: calc(clamp(6.5rem, 12vw, 8.5rem) + 0.2rem); bottom: 1.6rem; width: calc(172 * var(--u)); height: calc(56 * var(--u)); z-index: 3; }
  .quick-deck :global(.qk-slot) {
    position: absolute; right: 0; bottom: 0;
    transform-origin: 50% 100%;
    transform: translateY(calc(var(--depth) * -7 * var(--u))) scale(calc(1 - 0.05 * var(--depth)));
    transition: transform 420ms var(--ease-spring);
    z-index: calc(10 - var(--depth));
  }
  .quick-deck.is-open :global(.qk-slot) { transform: translateY(calc(var(--depth) * -62 * var(--u))); }
  .quick-deck :global(.qk-slot[data-behind] .dc > :not(.dc-check)) { opacity: 0; }
  .quick-deck :global(.qk-slot[data-behind] .dc-check) { opacity: 0; }
  .quick-deck.is-open :global(.qk-slot[data-behind] .dc > *) { opacity: 1; }
  /* fanned out, the cards have the room above him; his bubble steps back */
  .quick-deck.is-open ~ .quick-milo .quick-bubble { opacity: 0; }
  .quick-deck :global(.dc) { cursor: pointer; }
  .quick-deck :global(.dc > *) { transition: opacity 200ms; }

  .quick-info { position: absolute; left: 1rem; bottom: 0.9rem; max-width: 40%; font-size: var(--step--1); color: var(--ink-3); line-height: 1.35; }

  @media (max-width: 34rem) {
    .quick-stage { min-height: 21rem; }
    .quick-milo { width: 5.6rem; }
    .quick-deck { --u: 0.068rem; right: 5.6rem; bottom: 3.4rem; }
    .quick-bubble { right: 10%; bottom: 150%; max-width: 15rem; }
    .quick-info { bottom: 0.7rem; max-width: 60%; }
  }
</style>

<script>
  import { reduce, chatter, $, $$, type MiloEl } from '../../scripts/demo';
  import { watch } from '../../scripts/milo';
  import { cardHTML, spoken, type Done } from '../../scripts/done-card';

  const root = $(document, '[data-quick]');
  const m = $<MiloEl>(root, 'milo-character');
  const words = $(root, '[data-words]');
  const text = $(words, '[data-text]');
  const reply = $(root, '[data-reply]');
  const deck = $(root, '[data-deck]');
  const info = $(root, '[data-info]');
  const undoThat = $<HTMLButtonElement>(root, '[data-undo-that]');
  const buttons = $$<HTMLButtonElement>(root, '[data-thing]');

  const clock = (d: Date) => d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
  const rings = () => `Rings at ${clock(new Date(Date.now() + 10 * 60_000))}`;

  // What he says comes from the brain's templates (quick_words.py); the cards are what the app draws.
  const things: { line: string; card: () => Done; opens?: string }[] = [
    { line: "Haircut, Friday at 1 pm. It's in.", card: () => ({ kind: 'event', title: 'Haircut', line: '13:00', day: ['Fri', '6'], undo: true }), opens: 'Calendar' },
    { line: "Oat milk. It's on your list.", card: () => ({ kind: 'todo', title: 'Oat milk', line: 'Shopping', undo: true }), opens: 'Reminders' },
    { line: 'Timer for 10 minutes is running.', card: () => ({ kind: 'timer', title: '10 minutes', line: rings(), left: '10m', undo: true }) },
    { line: 'The draft to Anna is open in Mail.', card: () => ({ kind: 'draft', title: 'Running late', line: 'Anna', undo: true }), opens: 'Mail' },
    { line: 'Noted: Boiler service.', card: () => ({ kind: 'note', title: 'Boiler service', line: 'On the 14th', undo: true }), opens: 'Notes' },
  ];

  interface Card { el: HTMLElement; slot: HTMLElement; title: string; state: 'ready' | 'undoing' | 'undone'; timer: number; }
  const cards: Card[] = []; // on screen, oldest first
  const undoable: Card[] = []; // everything that can still be undone, oldest first; outlives its card
  let token = 0;
  let hovered = false;
  // A thing he has heard gets done even if you ask for the next one straight away, as in the app.
  let heard: number | null = null;
  const finish = () => {
    if (heard === null) return;
    const t = things[heard];
    heard = null;
    add(t.card(), t.opens);
  };
  const wait = (ms: number, me: number) => new Promise<void>((ok, no) => setTimeout(() => (me === token ? ok() : no()), reduce ? 0 : ms));

  function layout() {
    cards.forEach((c, i) => {
      const depth = cards.length - 1 - i;
      c.slot.style.setProperty('--depth', String(depth));
      c.slot.toggleAttribute('data-behind', depth > 0);
    });
    undoThat.disabled = !undoable.some((c) => c.state === 'ready');
  }

  // A card stays 8 seconds (4 in the app: here people read and click slower), and as long as the pointer is on the deck; then it tucks back into him.
  function expire(c: Card, ms = 8000) {
    clearTimeout(c.timer);
    c.timer = window.setTimeout(() => (hovered ? expire(c, 1500) : remove(c)), reduce ? ms * 2 : ms);
  }
  function remove(c: Card) {
    const i = cards.indexOf(c);
    if (i < 0) return;
    cards.splice(i, 1);
    clearTimeout(c.timer);
    c.el.classList.remove('is-landed');
    c.el.classList.add('is-leaving');
    setTimeout(() => c.slot.remove(), reduce ? 0 : 420);
    if (!cards.length) { hovered = false; deck.classList.remove('is-open'); }
    layout();
  }

  function add(d: Done, opens?: string) {
    const slot = document.createElement('div');
    slot.className = 'qk-slot';
    slot.setAttribute('role', 'listitem');
    const el = document.createElement('div');
    el.className = 'dc dc-fly';
    el.innerHTML = cardHTML(d, { buttons: true });
    el.setAttribute('aria-label', spoken(d));
    el.title = opens ? `Opens it in ${opens}` : '';
    slot.append(el);
    deck.append(slot);
    const c: Card = { el, slot, title: d.title, state: 'ready', timer: 0 };
    cards.push(c);
    undoable.push(c);
    if (cards.length > 3) remove(cards[0]);
    layout();
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-landed')));
    expire(c);
    el.querySelector('[data-undo]')?.addEventListener('click', (e) => { e.stopPropagation(); undo(c); });
    el.addEventListener('click', () => {
      info.textContent = opens ? `In the app, a click opens it in ${opens}.` : 'In the app, a click shows it in the Milo window.';
    });
  }

  async function undo(c: Card, me = ++token) {
    if (c.state !== 'ready') return;
    c.state = 'undoing';
    c.el.dataset.undo = 'undoing';
    layout();
    try {
      m.pose = 'thinking';
      await wait(700, me);
      c.state = 'undone';
      c.el.dataset.undo = 'undone';
      say(`Undid “${c.title}”.`, 'idle');
      if (cards.includes(c)) expire(c, 1800);
    } catch {
      c.state = 'undone';
      c.el.dataset.undo = 'undone';
    } finally {
      layout();
    }
  }

  function say(line: string, after = 'idle') {
    m.pose = 'speaking';
    reply.textContent = line;
    reply.classList.add('is-on');
    chatter(m, Math.min(2200, 300 + line.length * 45));
    setTimeout(() => { if (reply.textContent === line) m.pose = after; }, reduce ? 0 : 1500);
  }

  async function hear(said: string, me: number) {
    reply.classList.remove('is-on');
    info.textContent = '';
    words.classList.add('is-on', 'is-live');
    m.pose = 'listening';
    if (!reduce) watch(root);
    const all = said.split(' ');
    for (let i = 1; i <= all.length; i++) {
      text.textContent = all.slice(0, i).join(' ');
      if (i % 3 === 0) m.play('nod');
      await wait(150 + Math.random() * 70, me);
    }
    words.classList.remove('is-live');
    await wait(450, me);
    m.pose = 'thinking';
  }

  async function run(i: number) {
    finish();
    const me = ++token;
    const t = things[i];
    buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
    try {
      await hear(buttons[i].textContent!.replace('“', '').trim(), me);
      heard = i;
      await wait(900, me);
      // the thing is done first; then he says so
      finish();
      m.play('hop');
      await wait(420, me);
      say(t.line, 'happy');
      await wait(2400, me);
      words.classList.remove('is-on');
      m.pose = 'idle';
    } catch { /* another one started */ } finally {
      if (me === token) watch(null);
    }
  }

  async function undoByVoice() {
    finish();
    const c = [...undoable].reverse().find((x) => x.state === 'ready');
    if (!c) return;
    const me = ++token;
    buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
    try {
      await hear('Undo that.', me);
      await undo(c, me);
      await wait(2200, me);
      words.classList.remove('is-on');
    } catch { /* another one started */ } finally {
      if (me === token) watch(null);
    }
  }

  buttons.forEach((b, i) => b.addEventListener('click', () => run(i)));
  undoThat.addEventListener('click', undoByVoice);
  deck.addEventListener('pointerenter', () => { if (cards.length) { hovered = true; deck.classList.add('is-open'); } });
  deck.addEventListener('pointerleave', () => { hovered = false; deck.classList.remove('is-open'); });
  deck.addEventListener('focusin', () => { hovered = true; deck.classList.add('is-open'); });
  deck.addEventListener('focusout', (e) => { if (!deck.contains(e.relatedTarget as Node)) { hovered = false; deck.classList.remove('is-open'); } });

  if (reduce) {
    // no play: the first one, done
    text.textContent = buttons[0].textContent!.replace('“', '').trim();
    words.classList.add('is-on');
    add(things[0].card(), things[0].opens);
    clearTimeout(cards[0].timer); // a still picture keeps its card
    reply.textContent = things[0].line;
    reply.classList.add('is-on');
  } else {
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); run(0); } }, { threshold: 0.55 });
    io.observe(root);
  }
</script>
