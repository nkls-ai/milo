---
import Character from './Character.astro';
---
<header class="nav" data-nav>
  <div class="wrap nav-row">
    <a class="brand" href="#top" aria-label="Milo, back to the top">
      <span class="brand-mark"><Character id="nav" small /></span>
      <span class="brand-name">Milo</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        <li><a href="#talk">How he works</a></li>
        <li><a href="#trust">Privacy</a></li>
        <li><a href="#pricing">Pricing</a></li>
        <li><a href="#faq">Questions</a></li>
      </ul>
    </nav>
    <div class="nav-end">
      <button class="theme" type="button" data-theme-toggle aria-label="Colour theme: same as your system">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="ic ic-auto"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="ic ic-light"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="ic ic-dark"><path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z" fill="currentColor"/></svg>
      </button>
      <a class="btn btn-small" href="#waitlist">Join the waitlist</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms;
  }
  .nav[data-scrolled] { border-bottom-color: var(--rule); }
  .nav-row { display: flex; align-items: center; gap: 1.5rem; height: 4.25rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--ink); border-radius: 0.5rem; }
  .brand-mark { width: 2.3rem; height: 2.3rem; margin-top: -0.35rem; }
  .brand-name { font-family: var(--font-display); font-variation-settings: 'SOFT' 100; font-weight: 620; font-size: 1.5rem; letter-spacing: -0.02em; }
  nav { margin-left: auto; }
  .nav-links { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-links a { display: block; padding: 0.45rem 0.8rem; border-radius: var(--radius-pill); color: var(--ink-2); text-decoration: none; font-size: 0.98rem; font-weight: 600; }
  .nav-links a:hover { color: var(--ink); background: var(--lavender-wash); }
  .nav-end { display: flex; align-items: center; gap: 0.6rem; }
  .theme { width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 0; background: transparent; color: var(--ink-2); display: grid; place-items: center; }
  .theme:hover { background: var(--lavender-wash); color: var(--ink); }
  .ic { width: 1.25rem; height: 1.25rem; grid-area: 1 / 1; display: none; }
  :global(:root:not([data-theme])) .ic-auto, :global(:root[data-theme='light']) .ic-light, :global(:root[data-theme='dark']) .ic-dark { display: block; }
  @media (max-width: 52rem) {
    nav { display: none; }
    .nav-end { margin-left: auto; }
  }
  @media (max-width: 24rem) {
    .nav-row { gap: 0.75rem; }
    .brand-name { font-size: 1.35rem; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Same as the system, then light, then dark, and round again.
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const root = document.documentElement;
  const names: Record<string, string> = { auto: 'same as your system', light: 'light', dark: 'dark' };
  const label = () => {
    const t = root.dataset.theme ?? 'auto';
    btn.setAttribute('aria-label', `Colour theme: ${names[t]}. Change it`);
  };
  btn.addEventListener('click', () => {
    const order = ['auto', 'light', 'dark'];
    const next = order[(order.indexOf(root.dataset.theme ?? 'auto') + 1) % 3];
    if (next === 'auto') { delete root.dataset.theme; localStorage.removeItem('milo-theme'); }
    else { root.dataset.theme = next; localStorage.setItem('milo-theme', next); }
    label();
    dispatchEvent(new CustomEvent('milo:theme', { detail: next }));
  });
  label();
</script>
