---
import { contactEmail } from '../site';
import Character from './Character.astro';
---
<section class="section waitlist" id="waitlist" aria-labelledby="waitlist-title">
  <div class="wrap wl-grid">
    <div class="wl-copy">
      <h2 id="waitlist-title">Milo's nearly ready.</h2>
      <p>He's being tested by a few families now. Leave your email and we'll write once, when he's ready for you.</p>
      <form class="wl-form" data-wl novalidate>
        <label for="wl-email" class="wl-label">Your email</label>
        <div class="wl-row">
          <input id="wl-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required aria-describedby="wl-note wl-msg" />
          <button class="btn" type="submit">Join the waitlist</button>
        </div>
        <p class="note" id="wl-note">This form is a placeholder and doesn't send anything yet.</p>
        <p class="wl-msg" id="wl-msg" data-msg role="status" aria-live="polite"></p>
      </form>
    </div>
    <div class="wl-stage">
      <div class="wl-perch" aria-hidden="true"></div>
      <div class="wl-slot" data-milo-slot="final">
        <Character id="final" pose="happy" class="wl-static" />
      </div>
    </div>
  </div>
</section>

<style>
  .waitlist { padding-bottom: clamp(5rem, 9vw, 8rem); }
  .wl-grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 60rem) { .wl-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  h2 { font-size: var(--step-4); letter-spacing: -0.03em; }
  .wl-copy > p { margin-top: 1.3rem; font-size: var(--step-1); color: var(--ink-2); max-width: 32rem; }
  .wl-form { margin-top: 2rem; max-width: 34rem; }
  .wl-label { display: block; font-weight: 650; margin-bottom: 0.45rem; }
  .wl-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  input {
    flex: 1 1 14rem; min-width: 0;
    min-height: 3rem; padding: 0.6rem 1.1rem;
    border: 0; border-radius: var(--radius-pill);
    background: var(--card);
    box-shadow: inset 0 0 0 1.5px var(--rule-strong);
    caret-color: var(--lavender);
    font-size: 1.05rem;
  }
  input::placeholder { color: var(--ink-3); }
  input:focus-visible { outline: 3px solid var(--lavender); outline-offset: 2px; }
  .wl-form .note { margin-top: 0.7rem; }
  .wl-msg { margin-top: 0.8rem; font-weight: 600; }
  .wl-msg:empty { display: none; }
  .wl-stage { position: relative; justify-self: center; width: min(19rem, 52vw); }
  .wl-slot { width: 100%; aspect-ratio: 1; position: relative; }
  /* without scripts Milo sits here; with them, the flying Milo lands here instead */
  :global(.js) .wl-slot :global(.wl-static) { visibility: hidden; }
  .wl-perch { position: absolute; left: 8%; right: 8%; bottom: 7%; height: 9%; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--scarf) 30%, transparent), transparent); }
</style>

<script define:vars={{ contactEmail }}>
  const form = document.querySelector('[data-wl]');
  const msg = form.querySelector('[data-msg]');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = form.email.value.trim();
    const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    msg.replaceChildren();
    if (!ok) {
      msg.textContent = 'That email looks incomplete. It needs an @ and a dot, like anna@example.com.';
      form.email.setAttribute('aria-invalid', 'true');
      form.email.focus();
      return;
    }
    form.email.removeAttribute('aria-invalid');
    const a = document.createElement('a');
    a.href = `mailto:${contactEmail}?subject=${encodeURIComponent('Milo waitlist')}&body=${encodeURIComponent(`Please add ${email} to the Milo waitlist.`)}`;
    a.textContent = 'send us a short email';
    msg.append("Nothing was sent, because the waitlist isn't open yet. To hear when it opens, ", a, '.');
  });
</script>
